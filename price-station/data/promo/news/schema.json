{
  "schemaVersion": 1,
  "purpose": "超市「最新消息／宣傳海報」試探鏡像（非長期保證）",
  "fileLayout": {
    "index": "data/promo/news/index.json",
    "perStore": "data/promo/news/{scode}.json"
  },
  "storeObject": {
    "scode": "string — 對齊 promo/index.json stores[].scode",
    "name_cn": "string",
    "status": "ok | empty | no_stable_entry | login_required | broken_assets",
    "sourceUrl": "list 頁或入口 URL",
    "mirroredAt": "ISO8601+08:00",
    "items": [
      {
        "id": "store-local id",
        "title": "標題",
        "publishedAt": "原始頁面日期字串（可能不可靠）",
        "url": "明細頁 URL",
        "imageUrl": "海報／圖（可空）",
        "imageStatus": "ok | empty_body | ssl_error | missing | skipped",
        "localImage": "可選 data/promo/news/images/... 相對路徑",
        "notes": "字串陣列"
      }
    ],
    "notes": "店級說明"
  },
  "ui": "promo.html 卡片「最新消息」讀 news/index.json；無資料顯示原因，唔硬造"
}
