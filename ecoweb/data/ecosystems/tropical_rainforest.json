{
  "id": "tropical_rainforest",
  "name_zh": "熱帶雨林",
  "name_en": "Tropical rainforest",
  "scene_zh": "東南亞／亞馬遜類熱帶雨林（教學錨點）",
  "disclaimer_zh": "教學簡化：物種與連線為課堂可見模型，唔等於真實完整生態。",
  "abiotic": [
    "陽光（林冠截取）",
    "高濕度／降雨",
    "土壤養分循環快",
    "垂直層次（光隙）"
  ],
  "energy_arrow_convention": "from=被取食／資源方；to=獲能方（消費者／受益方）。競爭為無能量流向之雙向關係，用 from／to 僅標兩端物種。",
  "species": [
    {
      "id": "emergent_tree",
      "name_zh": "高大喬木（林冠／突生層）",
      "name_la": null,
      "trophic": "producer",
      "blurb_l1": "形成林冠與突生層的高大樹木，攔截大部分陽光並生產大量有機物。",
      "blurb_l2": "果實、葉與枯枝落葉是草食者與分解者的主要入口；亦提供附生植物著生表面。",
      "image": "assets/tropical_rainforest/emergent_tree.png"
    },
    {
      "id": "epiphyte_orchid",
      "name_zh": "附生蘭",
      "name_la": "Orchidaceae（示意）",
      "trophic": "producer",
      "blurb_l1": "著生於樹幹或枝條的蘭科植物，自行光合作用。",
      "blurb_l2": "依賴傳粉昆蟲完成繁殖；教學上代表林冠附生生產者，而非寄生吸取樹液。",
      "image": "assets/tropical_rainforest/epiphyte_orchid.png"
    },
    {
      "id": "understory_herb",
      "name_zh": "林下草本",
      "name_la": null,
      "trophic": "producer",
      "blurb_l1": "適應低光環境的林下草本與幼苗層。",
      "blurb_l2": "光隙出現時可短暫加速生長；是地面與下層草食者的食源。",
      "image": "assets/tropical_rainforest/understory_herb.png"
    },
    {
      "id": "three_toed_sloth",
      "name_zh": "三趾樹懶（示意）",
      "name_la": "Bradypus spp.（示意）",
      "trophic": "primary_consumer",
      "blurb_l1": "在樹冠緩緩取食樹葉的樹棲草食哺乳類示意。",
      "blurb_l2": "代謝慢、活動少；教學上代表林冠葉食者，亦可示意被大型貓科機會性捕食。",
      "image": "assets/tropical_rainforest/three_toed_sloth.png"
    },
    {
      "id": "scarlet_macaw",
      "name_zh": "金剛鸚鵡（示意）",
      "name_la": "Ara spp.（示意）",
      "trophic": "primary_consumer",
      "blurb_l1": "取食果實、種子與堅果的大型鸚鵡。",
      "blurb_l2": "部分種子經消化或攜帶後傳播，可示範種子傳播互利；亦與犀鳥等爭用果實。",
      "image": "assets/tropical_rainforest/scarlet_macaw.png"
    },
    {
      "id": "hornbill",
      "name_zh": "犀鳥（示意）",
      "name_la": "Bucerotidae（示意）",
      "trophic": "primary_consumer",
      "blurb_l1": "以果實為主、偶取小型動物的大型林鳥示意。",
      "blurb_l2": "長距離吞食並排泄種子，是熱帶林種子傳播的經典教學例子。",
      "image": "assets/tropical_rainforest/hornbill.png"
    },
    {
      "id": "leafcutter_ant",
      "name_zh": "切葉蟻",
      "name_la": "Atta / Acromyrmex（示意）",
      "trophic": "primary_consumer",
      "blurb_l1": "剪切樹葉搬回巢穴、培養真菌作為食源的社會性昆蟲。",
      "blurb_l2": "教學上以「取葉→真菌農場」簡化為草食入口；與樹懶等爭用葉資源（示意）。",
      "image": "assets/tropical_rainforest/leafcutter_ant.png"
    },
    {
      "id": "orchid_pollinator",
      "name_zh": "蘭花傳粉昆蟲（示意）",
      "name_la": null,
      "trophic": "primary_consumer",
      "blurb_l1": "訪花取食花蜜／花粉的蜂類或其他昆蟲示意。",
      "blurb_l2": "與附生蘭形成傳粉互利；亦是樹蛙等的獵物。",
      "image": "assets/tropical_rainforest/orchid_pollinator.png"
    },
    {
      "id": "tree_frog",
      "name_zh": "樹蛙",
      "name_la": "Hylidae 等（示意）",
      "trophic": "secondary_consumer",
      "blurb_l1": "在葉面與枝條捕食小型昆蟲的兩棲類。",
      "blurb_l2": "依賴潮濕微生境；教學上串起「傳粉昆蟲→蛙→大型掠食者」的能量階梯。",
      "image": "assets/tropical_rainforest/tree_frog.png"
    },
    {
      "id": "jaguar",
      "name_zh": "美洲豹／雲豹類（示意）",
      "name_la": "Panthera onca / Neofelis（示意）",
      "trophic": "apex_consumer",
      "blurb_l1": "林中埋伏、捕食中大型脊椎動物的近頂級貓科示意。",
      "blurb_l2": "教學上合併美洲豹與雲豹類角色：控制樹懶、猴類等樹棲／半樹棲獵物密度。",
      "image": "assets/tropical_rainforest/jaguar.png"
    },
    {
      "id": "rainforest_fungi",
      "name_zh": "真菌／微生物（示意）",
      "name_la": null,
      "trophic": "decomposer",
      "blurb_l1": "分解落葉、枯木與動物殘體的真菌與微生物示意。",
      "blurb_l2": "熱帶林養分多存於生物量；快速分解把養分釋回根系可及範圍（教學簡化）。",
      "image": "assets/tropical_rainforest/rainforest_fungi.png"
    },
    {
      "id": "rainforest_parasite",
      "name_zh": "體表／體內寄生物（示意）",
      "name_la": null,
      "trophic": "secondary_consumer",
      "blurb_l1": "寄生於脊椎動物、吸取血液或組織的小型寄生物示意。",
      "blurb_l2": "典型寄生（＋／－）；可示範對樹懶、美洲豹等宿主的負擔。",
      "image": "assets/tropical_rainforest/rainforest_parasite.png"
    }
  ],
